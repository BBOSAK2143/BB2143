{
  "manifest_version": 3,
  "name": "BBOSAK2143 Eye-Saver (Zero Black & White)",
  "version": "2.0.0",
  "description": "Eliminates harsh black & white web pages with the ergonomic BBOSAK2143 teal, green, amber, and crimson palette.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BBOSAK2143 Eye-Saver",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["eyesaver.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bbosak2143-eyesaver@bbosak2143.org",
      "strict_min_version": "109.0"
    }
  }
}
